//Search Database by ID/////////////////////////////////////////////////////////
procedure TMusicPlayer.btnSearchByIDClick(Sender: TObject);
var
   IDSearch: integer;
begin
   IDSearch:=StrToInt(Inputbox('Enter Song ID','ID',''));
   dmMediaPlayer.tblMedia.First;
   With dmMediaPlayer Do
       while Not tblMedia.Eof do
            Begin
               If IDSearch = tblMedia['ID'] Then
                 Begin
                    ShowMessage('The Name of the song is: ' + tblMedia['Name']);
                    if MessageDlg('Would you like to play this' +
                       'song?',mtInformation,[mbYes,mbNo], 0) = mrYes then
                      Begin
                        Play;
                        Timer1.Enabled:=True;
                        btnNext.Enabled:=True;
                        btnPrevious.Enabled:=True;
                        btnForward.Enabled:=True;
                        btnRewind.Enabled:=True;
                        btnStop.Enabled:=True;
                        btnRepeat.Enabled:=True;
                        pcMusicPlayer.ActivePage:=tbMusicPlayer;
                      End;
                    Exit;
                 End;
               tblMedia.Next;
            End;
end;
