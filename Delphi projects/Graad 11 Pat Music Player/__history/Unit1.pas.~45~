//Procedure Play////////////////////////////////////////////////////////////////
procedure TMusicPlayer.Play;//Checks if song is vidoe or not and Plays songs
Var
   sPlay, sMin, spos: string;
   iPlayPos, icolonpos, imin: integer;
begin
   ipos:=0;
   if dmMediaplayer.tblMedia['Video'] = True then
     Begin
        WindowsMediaPlayer1.URL:='Videos/' + dmMediaPlayer.tblMedia['Name']
                                 + dmMediaPlayer.tblMedia['Extention'];
        Panel2.Visible:=True;
        image1.Picture.LoadFromFile( 'Gifs/splash-wallpaper-paper-color'
               + '-wallpapers-mickadesign-devianart-great-details-media');
        btnFulScreen.Enabled:=True
     End
        Else
            Begin
               WindowsMediaPlayer1.URL:='Music/' +dmMediaPlayer.tblMedia['Name']
                                          + dmMediaPlayer.tblMedia['Extention'];
               image1.Picture.LoadFromFile('Gifs/'
                                           + dmMediaPlayer.tblMedia['Gif']);
               (Image1.Picture.Graphic as TGIFImage).Animate := True;
               Panel2.Visible:=False;
               btnFulScreen.Enabled:=False;
            End;
   sPlay:=dmMediaPlayer.tblMedia['Duration'];
   icolonpos:=pos(':',sPlay);
   sMin:=Copy(sPlay,1,icolonpos-1);
   imin:=StrToInt(smin);
   Delete(sPlay,1,icolonpos);
   iplaypos:=StrToInt(sPlay);
   pgDuration.Max:=iPlaypos + imin * 60;
   SongPicked:=True;
   lblName.Caption:= dmMediaPlayer.tblMedia['Name'];
   WindowsMediaplayer1.controls.currentPositionString;
   Timer1.Enabled:=True;
end;
//Play Playlist/////////////////////////////////////////////////////////////////
procedure TMusicPlayer.PlayPlaylist;
Var
   i: integer;
begin
   i:=iPlaylistPos;
   Inc(iPlaylistPos);
   if (ArrPlaylist[iPlaylistPos] = '') then
     Begin
        btnStopPlaylist.Enabled:=False;
        Panel2.Visible:=False;
        pgDuration.Position:=0;
        iPlaylistPos:=0;
        bpPlaylist:=False;
        btnNext.Enabled:=False;
        btnPrevious.Enabled:=False;
        iPlayFirst:=0;
        WindowsMediaPlayer1.Controls.Stop;
        pgDuration.Position:=0;
        Timer1.Enabled:=False;
     End
        Else
            Begin
               WindowsMediaplayer1.Url:='Music/' + ArrPlaylist[iPlaylistPos];
               pgDuration.Max:=arrSongDuration[iPlaylistPos];
               pgDuration.Position:=0;
               panel2.Visible:=True;
               btnNext.Enabled:=True;
               btnPrevious.Enabled:=True;
               lblName.Caption:=ArrPlaylist[iPlaylistPos];
            End;
end;

