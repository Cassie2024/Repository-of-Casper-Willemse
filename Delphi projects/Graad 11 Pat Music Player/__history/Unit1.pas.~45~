//Add To playlist in database///////////////////////////////////////////////////
procedure TMusicPlayer.btnAddToPlaylistClick(Sender: TObject);
Var
   tPlaylist,tCreate: TextFile;
   sLine, sSongName: String;
   i :Integer;
begin
   if MessageDlg('Would you like to Create new Playlist' +
                 'song?',mtInformation,[mbYes,mbNo], 0) = mrYes then
     Begin
        if dmMediaPlayer.tblMedia['Video'] = True then
          Begin
             ShowMessage('Sorry You cant add video files to the playlist');
             Exit;
          End
             Else
                 Begin
                    sLine:=InputBox('Create playlist','Specify name','');
                    AssignFile(tCreate,'TextFiles/' + sLine +'.txt');
                    Rewrite(tCreate);
                    Writeln(tCreate,dmMediaPlayer.tblMedia['Name']
                                 +dmMediaPlayer.tblMedia['Extention'] + '#'
                                 +dmMediaPlayer.tblMedia['Duration']);
                    CloseFile(tCreate);
                 End;
     End
        Else
            Begin
               sLine:=InputBox('Add to existig playlist','Specify name','');
               AssignFile(tPlaylist,'TextFiles/' + sLine +'.txt');
               Append(tplaylist);
               Writeln(tPlayList,dmMediaPlayer.tblMedia['Name']
                                +dmMediaPlayer.tblMedia['Extention'] + '#'
                                +dmMediaPlayer.tblMedia['Duration']);
               CloseFile(tPlaylist);
            End;

end;
