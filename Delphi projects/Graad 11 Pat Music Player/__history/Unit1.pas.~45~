//Play/Puase Button also for playing first record///////////////////////////////
procedure TMusicPlayer.btnPlayPauseClick(Sender: TObject);
begin
   if iPlayFirst = 0 then
     Begin
        if panel2.Visible = True then
          Begin
             Panel2.Visible:=False;
          End;
        bpPlaylist:=False;
        pgDuration.Position:=0;
        iPlaylistPos:=0;
        Play;
        iplayFirst:=1;
        btnNext.Enabled:=True;
        btnPrevious.Enabled:=True;
        btnForward.Enabled:=True;
        btnRewind.Enabled:=True;
        btnStop.Enabled:=True;
        btnStopPlaylist.Enabled:=False;
        if dmMediaPlayer.tblMedia['Video'] = True then
          Begin
             btnFulScreen.Enabled:=True;
          End;
        btnRepeat.Enabled:=True;
        SongPicked:=True;
     End
        Else
            Begin
               if paused = true then
                 Begin
                    paused:=False;
                    WindowsMediaplayer1.controls.play;
                    Timer1.Enabled:=True;
                 End
                    Else
                        Begin
                           paused:= True;
                           WindowsMediaplayer1.controls.pause;
                           Timer1.Enabled:=False;
                        End;
            End;
end;
//Play Playlist/////////////////////////////////////////////////////////////////
procedure TMusicPlayer.btnPlayPlaylistClick(Sender: TObject);
Var
   tPlaylist: TStringList;
   f: TextFile;
   sLine,s: String;
   i, k, x, iLength, ipos, inumber: integer;
   sPlay, sMin, spos: string;
   iPlayPos, icolonpos, imin: integer;
begin
   if bArraysPopulated = False then
     Begin
   tPlaylist:= tStringlist.Create;
   i:=0;
   AssignFile(f,'TextFiles/' +InputBox('Play:','Specify Playlist','')+ '.txt');
   Reset(f);
   while (Not Eof(f)) And (i < 30) do
        Begin
           Inc(i);
           Readln(f,sLine);
           ipos:=Pos('#',sLine);
           ilength:=Length(sline);
           s:=copy(sLine,ipos + 1,ilength);
           Delete(sline,ipos,iLength);
           icolonpos:=pos(':',s);
           sMin:=Copy(s,1,icolonpos-1);
           imin:=StrToInt(smin);
           Delete(s,1,icolonpos);
           iplaypos:=StrToInt(s);
           ArrSongDuration[i]:=iPlaypos + imin * 60;
           ArrPlaylist[i]:=sLine;
           bArraysPopulated:=True;
           btnNext.Enabled:=True;
           btnPrevious.Enabled:=True;
        End;
        End;
   SongPicked:=True;
   bpPlaylist:=True;
   iPlaylistPos:=0;
   pgduration.Position:=0;
   btnStopPlaylist.Enabled:=True;
   Timer1.Enabled:=True;
end;
