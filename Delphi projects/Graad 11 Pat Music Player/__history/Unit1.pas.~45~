procedure TMusicPlayer.stop;
begin
   ipos:=0;
   Timer1.Enabled:=False;
   windowsMediaPlayer1.controls.stop;
   pgDuration.Position:=0;
   image1.Picture.LoadFromFile( 'Gifs/splash-wallpaper-paper-color-wallpapers'
                                + '-mickadesign-devianart-great-details-media');
   iplayFirst:=0;
   dmMediaPlayer.tblMedia.First;
   SongPicked:=False;
   if panel2.Visible = True then
     Begin
        Panel2.Visible:=False;
     End;
     BtnPrevious.Enabled:=False;
     btnRepeat.Enabled:=False;
     BtnNext.Enabled:=False;
     btnForward.Enabled:=False;
     btnRewind.Enabled:=False;
     btnFulScreen.Enabled:=False;
     btnStop.Enabled:=False;
end;

//Program Timer makes the Songs Continuously play///////////////////////////////
procedure TMusicPlayer.Timer1Timer(Sender: TObject);
begin
   if bpPlaylist = True then
     Begin
        If iPlaylistPos = 0 Then
          Begin
             PlayPlaylist;
          End
             Else
                 Begin
                    SetProgressbar;
                    if pgDuration.Position = pgDuration.Max then
                      Begin
                         SetProgressbar;
                         PlayPlaylist;
                      End;
                 End;
     End
        Else
            Begin
               TimerCode;
            End;
end;
procedure TMusicPlayer.TimerCode;
begin

   SetProgressbar;
   if songPicked = True then
     Begin
        if ipos < 0 then
          Begin
             bRewind:= False;
             bforward:=False;
             ipos:=0;
             songpicked:=False;
             if IDFirst = dmMediaplayer.tblMedia['ID'] then
               Begin
                  dmMediaplayer.tblMedia.First;
               End
                  Else
                      Begin
                         dmMediaPlayer.tblMedia.prior;
                      End;
             if bRepeat = True then
               Begin
                 play;
               End;
          End;
        if (WindowsMediaplayer1.controls.currentPositionString =
           dmMediaplayer.tblMedia['Duration']) Or
           (WindowsMediaPlayer1.playState= wmppsStopped = true) then
          Begin
             pgDuration.Position:=0;
             bForward:= False;
             bRewind:=False;
             songpicked:=False;
             if IDLast = dmMediaplayer.tblMedia['ID'] then
               Begin
                  dmMediaplayer.tblMedia.First;
               End
                  Else
                      Begin
                         dmMediaPlayer.tblMedia.Next;
                      End;
             if bRepeat = True then
               Begin
                 play;
               End;
          End;
     End;

end;

