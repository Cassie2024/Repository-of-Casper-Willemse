procedure TMusicPlayer.Button5Click(Sender: TObject);
Var
   iUpper, iLower,iCount: integer;
begin
  iCount:=0;
  iUpper:=StrToInt(InputBox('Enter Max length in seconds.','Max Length',''));
  iLower:=StrToInt(InputBox('Enter Minimum Length in seconds','Min Length',''));
  dmMediaPlayer.tblMedia.Filter:='Duration <'''+IntToStr(IUpper)+''''
                                 + 'And Duration >'''+IntToStr(iLower)+'''';
  dmMediaPlayer.tblMedia.Filtered:=True;
  dmMediaPlayer.tblMedia.Last;
  IdLast:=dmMediaPlayer.tblMedia['Id'];
  dmMediaPlayer.tblMedia.First;
   while Not(dmMediaPlayer.tblMedia.Eof) do
        Begin
           Inc(Icount);
           dmMediaPlayer.tblMedia.Next;
        End;
   dmMediaPlayer.tblMedia.First;
   redSummary.Lines.Add('There was ' + IntToStr(iCount) + 'records found for '
                        + 'Songs between ' + IntToStr(iLower) + ' And '
                        + IntToStr(iUpper));
