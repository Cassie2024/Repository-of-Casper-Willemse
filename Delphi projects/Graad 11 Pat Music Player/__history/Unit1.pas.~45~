begin
   if (WindowsMediaplayer1.controls.currentPositionString =
       dmMediaplayer.tblMedia['Duration']) Or
      (WindowsMediaPlayer1.playState= wmppsStopped = true) then
     Begin

     End
        Else
            Begin
              sPlay:=windowsMediaPlayer1.controls.currentPositionString;
              if sPlay = '' then
                Begin

                End
                   Else
                       Begin
                          icolonpos:=pos(':',sPlay);
